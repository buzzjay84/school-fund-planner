{
  "name": "school-fund-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^26.18.1",
    "electron-vite": "6.0.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "productName": "School Fund Planner",
  "description": "Prepare a school MOOE budget: alignment, monthly SOB and quarterly APP.",
  "author": "Jonybhee A. Bazan",
  "build": {
    "appId": "com.buzzjay84.schoolfundplanner",
    "productName": "School Fund Planner",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "icon": "src/image/app_logo.png",
    "publish": [
      {
        "provider": "github",
        "owner": "buzzjay84",
        "repo": "school-fund-planner"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "School Fund Planner",
      "artifactName": "School-Fund-Planner-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "School-Fund-Planner-${version}-${arch}.${ext}"
    }
  }
}
